loadaddr=0x82000000
kerneladdr=0x82000000
fdtaddr=0x88000000
ramfsaddr=0x88080000
scriptaddr=0x80000000

id_i2c_bus=1
id_i2c_addr=50

board_41424356=setenv fdtfile k3-am625-cerbo-b10.dtb
board_42424356=setenv fdtfile k3-am625-cerbo-b11.dtb
board_34424356=setenv fdtfile k3-am625-cerbo-b11-b4.dtb
board_33614343=setenv fdtfile k3-am625-cerbo-b12a-b3.dtb
board_34614343=setenv fdtfile k3-am625-cerbo-b12a-b4.dtb

console=ttyS0,115200
bootfile=Image
fdtfile=DEFAULT_DEVICE_TREE.dtb
ramfsfile=initramfs
bootscript=boot.scr

setboardid=
	i2c dev ${id_i2c_bus};
	i2c read ${id_i2c_addr} 0 4 ${loadaddr};
	if test ${mmcdev} = 1; then
		load mmc 1:1 ${loadaddr} board_id;
	fi;
	setexpr.l board_id *${loadaddr};
setfdt=run board_${board_id} || echo unknown board_id ${board_id}
setroot=
	setexpr rootpart ${version} + 1;
	setenv bootpart 0:${rootpart};
	setenv mmcroot /dev/mmcblk0p${rootpart};
setmodel=
	if env exists model; then
		fdt set / model "${model}";
	else
		true;
	fi;

loadfdt=
	load mmc ${bootpart} ${fdtaddr} ${bootdir}/${fdtfile};
	fdt addr ${fdtaddr};
	run setmodel;
loadimage=load mmc ${bootpart} ${kerneladdr} ${bootdir}/${bootfile}
loadramfs=load mmc ${bootpart} ${ramfsaddr} ${bootdir}/${ramfsfile}
loadscript=load mmc ${bootpart} ${scriptaddr} ${bootscript}

mmcargs=setenv bootargs console=${console} root=${mmcroot} rootwait ro rootfstype=ext4 ${runlevel}
testmode=
	if test ${runlevel} = 4; then
		fdt rm nvmem0 read-only;
	else
		true;
	fi

boot_mmc_auto=run boot_mmc${mmcdev}
boot_mmc0=
	setenv bootdir /boot;
	run setroot loadfdt loadimage mmcargs testmode && booti ${kerneladdr} - ${fdtaddr};
boot_mmc1=
	setenv bootdir;
	setenv bootpart 1:1;
	run loadscript && source ${scriptaddr};
	run boot_mmc0;

runlevel=5
version=1
